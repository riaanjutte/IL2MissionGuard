#include "resource.h"
#include <windows.h>

IDI_APP_ICON ICON "..\\..\\assets\\IL2MissionGuard.ico"
IDI_TRAY_ICON ICON "..\\..\\assets\\IL2MissionGuard-tray.ico"
IDR_WPF_UI RCDATA "Generated\\IL2MissionGuard.UI.exe"

IDD_SETTINGS DIALOGEX 0, 0, 290, 202
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "IL-2 Mission Guard settings"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX        "Autosave and recovery points", IDC_STATIC, 8, 7, 274, 145
    CONTROL         "IL-2 Great Battles autosave", IDC_GREAT_BATTLES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 30, 20, 190, 12
    CONTROL         "IL-2 Korea autosave", IDC_KOREA, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 30, 39, 190, 12
    LTEXT           "Save every", IDC_STATIC, 30, 59, 58, 12
    EDITTEXT        IDC_INTERVAL, 92, 56, 34, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "minutes (1-60)", IDC_STATIC, 132, 59, 80, 12
    LTEXT           "Keep", IDC_STATIC, 30, 80, 58, 12
    EDITTEXT        IDC_SNAPSHOTS, 92, 77, 34, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "recovery points per mission (1-100)", IDC_STATIC, 132, 80, 142, 12
    CONTROL         "Notify after successful recovery points", IDC_NOTIFICATIONS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 30, 99, 220, 12
    LTEXT           "Failures are always shown as notifications.", IDC_FAILURE_NOTE, 30, 119, 245, 12
    LTEXT           "Appearance:", IDC_STATIC, 30, 137, 58, 12
    COMBOBOX        IDC_THEME, 92, 134, 115, 55, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "New missions need one manual save first.", IDC_NEW_MISSION_NOTE, 8, 160, 274, 13, SS_CENTER
    DEFPUSHBUTTON   "Save", IDOK, 180, 177, 50, 16, WS_TABSTOP
    PUSHBUTTON      "Cancel", IDCANCEL, 234, 177, 50, 16, WS_TABSTOP
END

IDD_STATUS DIALOGEX 0, 0, 370, 230
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "IL-2 Mission Guard"
FONT 9, "Segoe UI"
BEGIN
    ICON            IDI_APP_ICON, IDC_STATIC, 12, 12, 24, 24
    LTEXT           "Protection status", IDC_STATIC, 46, 10, 90, 10
    LTEXT           "Starting...", IDC_STATUS_STATE, 46, 23, 306, 16
    GROUPBOX        "Current activity", IDC_STATIC, 10, 44, 350, 66
    LTEXT           "Detected editors:", IDC_STATIC, 20, 59, 80, 10
    LTEXT           "None", IDC_STATUS_EDITORS, 108, 59, 240, 10
    LTEXT           "Open missions:", IDC_STATIC, 20, 76, 80, 10
    LTEXT           "None", IDC_STATUS_MISSIONS, 108, 76, 240, 25
    GROUPBOX        "Recovery", IDC_STATIC, 10, 116, 350, 68
    LTEXT           "Last recovery point:", IDC_STATIC, 20, 131, 92, 10
    LTEXT           "None this session", IDC_STATUS_LAST_SAVE, 118, 131, 230, 10
    LTEXT           "Next recovery point:", IDC_STATIC, 20, 148, 92, 10
    LTEXT           "Not scheduled", IDC_STATUS_NEXT_SAVE, 118, 148, 230, 10
    LTEXT           "Stored recovery points:", IDC_STATIC, 20, 165, 100, 10
    LTEXT           "0", IDC_STATUS_COUNT, 126, 165, 60, 10
    LTEXT           "Last issue:", IDC_STATIC, 10, 191, 52, 10
    LTEXT           "None", IDC_STATUS_ISSUE, 66, 191, 224, 23
    LTEXT           "v1.4.0", IDC_STATUS_VERSION, 305, 195, 50, 10, SS_RIGHT
    PUSHBUTTON      "Create recovery point now", IDC_STATUS_SAVE_NOW, 10, 209, 128, 16, WS_TABSTOP
    PUSHBUTTON      "Open recovery folder", IDC_STATUS_FOLDER, 143, 209, 102, 16, WS_TABSTOP
    DEFPUSHBUTTON   "Close", IDCANCEL, 310, 209, 50, 16, WS_TABSTOP
END

IDD_THEMED_MESSAGE DIALOGEX 0, 0, 290, 104
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "IL-2 Mission Guard"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_MESSAGE_BODY, 14, 14, 262, 56, SS_NOPREFIX
    DEFPUSHBUTTON   "OK", IDOK, 182, 79, 46, 17, WS_TABSTOP
    PUSHBUTTON      "No", IDNO, 236, 79, 46, 17, WS_TABSTOP
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "IL2MissionGuard contributors"
      VALUE "FileDescription", "IL-2 Mission Guard"
      VALUE "FileVersion", "2.0.0"
      VALUE "InternalName", "IL2MissionGuard"
      VALUE "OriginalFilename", "IL2MissionGuard.exe"
      VALUE "ProductName", "IL-2 Mission Guard"
      VALUE "ProductVersion", "2.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
