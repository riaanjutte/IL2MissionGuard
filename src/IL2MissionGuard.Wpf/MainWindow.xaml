<ui:FluentWindow x:Class="IL2MissionGuard.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="IL-2 Mission Guard"
                 Width="946" Height="590" MinWidth="880" MinHeight="540"
                 WindowStartupLocation="CenterScreen"
                 Icon="pack://application:,,,/Assets/IL2MissionGuard.ico"
                 WindowBackdropType="None">
    <ui:FluentWindow.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Width" Value="168" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MetaLabelStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#16000000" BorderBrush="#18000000" BorderThickness="0,0,1,0">
            <Grid Margin="14,20,14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="12" Background="#1565C0">
                        <Image Source="pack://application:,,,/Assets/IL2MissionGuard-tray.ico" Margin="7" />
                    </Border>
                    <StackPanel Margin="12,2,0,0">
                        <TextBlock Text="MISSION GUARD" FontSize="11" FontWeight="Bold" Foreground="#55A8FF" />
                        <TextBlock Text="IL-2 protection" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button x:Name="OverviewNav" Style="{StaticResource NavButtonStyle}" Click="OverviewNav_Click">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Home24" Margin="0,0,12,0" /><TextBlock Text="Overview" /></StackPanel>
                    </Button>
                    <Button x:Name="RecoveryNav" Style="{StaticResource NavButtonStyle}" Click="RecoveryNav_Click">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="History24" Margin="0,0,12,0" /><TextBlock Text="Recovery points" /></StackPanel>
                    </Button>
                    <Button x:Name="SettingsNav" Style="{StaticResource NavButtonStyle}" Click="SettingsNav_Click">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0" /><TextBlock Text="Settings" /></StackPanel>
                    </Button>
                    <Button x:Name="UpdatesNav" Style="{StaticResource NavButtonStyle}" Click="UpdatesNav_Click">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,12,0" /><TextBlock Text="Updates" /></StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="RUNNING IN THE TRAY" FontSize="10" FontWeight="Bold" Opacity="0.55" />
                    <TextBlock Text="You can close this window. Mission Guard remains active while an editor is open." TextWrapping="Wrap" FontSize="12" Opacity="0.72" Margin="0,6,0,12" />
                    <TextBlock x:Name="VersionText" FontSize="11" Opacity="0.5" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,24,28,24">
            <Grid x:Name="OverviewPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Overview" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Automatic, verifiable recovery points for both IL-2 Mission Editors." Opacity="0.68" Margin="0,6,0,0" />
                </StackPanel>

                <ui:Card Grid.Row="2" Padding="22">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border x:Name="StatusGlyph" Width="52" Height="52" CornerRadius="26" Background="#2765B7FF">
                            <ui:SymbolIcon x:Name="StatusIcon" Symbol="ShieldCheckmark24" FontSize="27" Foreground="#55A8FF" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,1,20,0">
                            <TextBlock x:Name="StateText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="StateDetailText" Opacity="0.66" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button Grid.Column="2" Appearance="Primary" Content="Create recovery point" Padding="18,9" Click="CreateRecovery_Click" />
                    </Grid>
                </ui:Card>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <ui:Card Padding="20">
                        <StackPanel>
                            <TextBlock Text="EDITORS" Style="{StaticResource MetaLabelStyle}" />
                            <TextBlock x:Name="EditorsText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="MissionsText" Opacity="0.66" Margin="0,7,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Grid.Column="2" Padding="20">
                        <StackPanel>
                            <TextBlock Text="LAST RECOVERY POINT" Style="{StaticResource MetaLabelStyle}" />
                            <TextBlock x:Name="LastSaveText" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock x:Name="NextSaveText" Opacity="0.66" Margin="0,7,0,0" />
                        </StackPanel>
                    </ui:Card>
                </Grid>

                <ui:Card Grid.Row="6" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="RECOVERY LIBRARY" Style="{StaticResource MetaLabelStyle}" />
                            <TextBlock x:Name="SnapshotCountText" FontSize="17" FontWeight="SemiBold" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="Browse recovery points" Click="RecoveryNav_Click" />
                        <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="13" CornerRadius="8" Background="#12FFC107">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Warning24" Foreground="#F4BE19" Margin="0,0,10,0" />
                                <TextBlock Text="New missions need one manual save first." Foreground="#F4BE19" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ui:Card>
            </Grid>

            <Grid x:Name="RecoveryPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Recovery points" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Browse verified snapshots for the active mission, or all missions when no editor is open." Opacity="0.68" Margin="0,6,0,0" />
                </StackPanel>
                <ui:Card Grid.Row="2" Padding="0">
                    <DataGrid x:Name="RecoveryGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" RowHeight="42"
                              ColumnWidth="Auto" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedLocal}" />
                            <DataGridTextColumn Header="Mission" Binding="{Binding Mission}" />
                            <DataGridTextColumn Header="Editor" Binding="{Binding Editor}" />
                            <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" />
                            <DataGridTextColumn Header="Integrity" Binding="{Binding Integrity}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </ui:Card>
                <Grid Grid.Row="4">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="RefreshRecovery_Click" />
                        <ui:Button Content="Open snapshot folder" Margin="10,0,0,0" Icon="{ui:SymbolIcon FolderOpen24}" Click="OpenSnapshots_Click" />
                        <ui:Button x:Name="DeleteSnapshotsButton" Content="Delete all snapshots" Margin="10,0,0,0"
                                   Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Click="DeleteSnapshots_Click" />
                    </StackPanel>
                    <ui:Button HorizontalAlignment="Right" Appearance="Primary" Content="Restore selected point" Icon="{ui:SymbolIcon History24}" Click="Restore_Click" />
                </Grid>
            </Grid>

            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Settings" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Choose which editors to protect and how frequently recovery points are kept." Opacity="0.68" Margin="0,4,0,10" />
                    <ui:Card Padding="14">
                        <StackPanel>
                            <TextBlock Text="MISSION EDITORS" Style="{StaticResource MetaLabelStyle}" Margin="0,0,0,5" />
                            <Grid Height="34">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="166" /></Grid.ColumnDefinitions>
                                <ui:ToggleSwitch x:Name="GreatBattlesCheck" Content="IL-2 Great Battles" />
                                <Border Grid.Column="1" Width="166" Height="34" CornerRadius="5" Background="#FF15191E" HorizontalAlignment="Right">
                                    <Image Source="Assets/IL2-Great-Battles.png"
                                           Width="150" Height="30"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           SnapsToDevicePixels="True" />
                                </Border>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Opacity="0.45" Margin="0,4" />
                            <Grid Height="34">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="166" /></Grid.ColumnDefinitions>
                                <ui:ToggleSwitch x:Name="KoreaCheck" Content="IL-2 Korea" />
                                <Border Grid.Column="1" Width="166" Height="34" CornerRadius="5" Background="#FF15191E" HorizontalAlignment="Right">
                                    <Image Source="Assets/IL2-Korea.png"
                                           Width="95" Height="32"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           SnapsToDevicePixels="True" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Padding="14" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="AUTOSAVE AND RECOVERY" Style="{StaticResource MetaLabelStyle}" Margin="0,0,0,5" />
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="105" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="Save every" VerticalAlignment="Center" />
                                <ui:NumberBox x:Name="IntervalBox" Grid.Column="1" Minimum="1" Maximum="60" SpinButtonPlacementMode="Compact" />
                                <TextBlock Grid.Column="2" Text="minutes (1–60)" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.65" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="105" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="Keep" VerticalAlignment="Center" />
                                <ui:NumberBox x:Name="RetentionBox" Grid.Column="1" Minimum="1" Maximum="100" SpinButtonPlacementMode="Compact" />
                                <TextBlock Grid.Column="2" Text="recovery points per mission (1–100)" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.65" />
                            </Grid>
                            <ui:ToggleSwitch x:Name="NotificationsCheck" Content="Notify after successful recovery points" />
                            <TextBlock Text="Failures are always shown as notifications." FontSize="12" Opacity="0.62" Margin="46,2,0,0" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Padding="14" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="230" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="APPEARANCE" Style="{StaticResource MetaLabelStyle}" />
                                <TextBlock Text="Theme" FontWeight="SemiBold" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Height="36" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Use Windows setting" Tag="System" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                            </ComboBox>
                        </Grid>
                    </ui:Card>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <ui:Button Content="Open settings file" Click="OpenSettingsFile_Click" />
                        <ui:Button Appearance="Primary" Content="Save settings" Margin="10,0,0,0" Padding="22,9" Click="SaveSettings_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="UpdatesPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="22" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Updates" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Updates are downloaded only from the official GitHub repository and verified with SHA-256." Opacity="0.68" Margin="0,6,0,0" />
                </StackPanel>
                <ui:Card Grid.Row="2" Padding="22">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="50" Height="50" CornerRadius="12" Background="#1F55A8FF">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="26" Foreground="#55A8FF" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,0">
                            <TextBlock x:Name="UpdateTitleText" Text="IL-2 Mission Guard is up to date" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="UpdateDetailText" Text="Check GitHub for the latest stable release." Opacity="0.66" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button x:Name="UpdateButton" Grid.Column="2" Content="Check now" Click="CheckUpdates_Click" />
                    </Grid>
                </ui:Card>
            </Grid>
        </Grid>

        <ui:Button Grid.ColumnSpan="2"
                   Panel.ZIndex="100"
                   Width="38" Height="38"
                   Margin="0,12,12,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Appearance="Secondary"
                   Icon="{ui:SymbolIcon Dismiss24}"
                   ToolTip="Close to the notification area"
                   AutomationProperties.Name="Close Mission Guard to the notification area"
                   Click="CloseWindow_Click" />
    </Grid>
</ui:FluentWindow>
